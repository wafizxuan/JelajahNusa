<?php
/**
 * JelajahNusa - Manajemen Pengguna (Kerangka & Tinjauan Akun)
 * Lokasi: admin/users.php
 */

require_once __DIR__ . '/auth_check.php';
require_once __DIR__ . '/../config/database.php';

// Ambil daftar pengguna (Tegas: Kolom password TIDAK diambil demi keamanan)
$users = [];
try {
    $stmt = $pdo->query('SELECT id, name, email, role, created_at FROM users ORDER BY id ASC');
    $users = $stmt->fetchAll();
} catch (PDOException $e) {
    error_log('[Admin Users Query Error] ' . $e->getMessage());
}
?>
