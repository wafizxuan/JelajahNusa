/**
 * JelajahNusa - Nature-Inspired Travel Guide & Planner
 * Frontend JavaScript Interactions
 */

document.addEventListener('DOMContentLoaded', () => {
  // Elements
  const navbar = document.querySelector('.custom-navbar');
  const backToTopBtn = document.getElementById('backToTopBtn');
  const heroSearchForm = document.getElementById('heroSearchForm');
  const searchInput = document.getElementById('heroSearchInput');
  const categorySelect = document.getElementById('heroCategorySelect');
  const destinationCards = document.querySelectorAll('.destination-card-col');
  const noDestinationsNotice = document.getElementById('noDestinationsNotice');

  // ========================================================================
  // 1. Sticky Navbar on Scroll
  // ========================================================================
  const handleScroll = () => {
    if (window.scrollY > 50) {
      navbar.classList.add('scrolled');
      if (backToTopBtn) backToTopBtn.classList.add('active');
    } else {
      navbar.classList.remove('scrolled');
      if (backToTopBtn) backToTopBtn.classList.remove('active');
    }
  };

  window.addEventListener('scroll', handleScroll);
  handleScroll();

  // ========================================================================
  // 2. Back To Top
  // ========================================================================
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  // ========================================================================
  // 3. Active Nav Link on Scroll
  // ========================================================================
  const sections = document.querySelectorAll('header[id], section[id]');
  const navLinks = document.querySelectorAll('.navbar-nav .nav-link');

  const highlightNavLink = () => {
    const scrollY = window.pageYOffset;

    sections.forEach((current) => {
      const sectionHeight = current.offsetHeight;
      const sectionTop = current.offsetTop - 130;
      const sectionId = current.getAttribute('id');

      if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
        navLinks.forEach((link) => {
          link.classList.remove('active');
          if (link.getAttribute('href') === `#${sectionId}`) {
            link.classList.add('active');
          }
        });
      }
    });
  };

  window.addEventListener('scroll', highlightNavLink);

  // Close mobile navbar on link click
  const navCollapse = document.getElementById('navbarContent');
  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (navCollapse && navCollapse.classList.contains('show')) {
        const bsCollapse = bootstrap.Collapse.getInstance(navCollapse);
        if (bsCollapse) bsCollapse.hide();
      }
    });
  });

  // ========================================================================
  // 4. Destination Search & Filter
  // ========================================================================
  const filterDestinations = (keyword = '', category = '') => {
    const cleanKeyword = keyword.trim().toLowerCase();
    const cleanCategory = category.trim().toLowerCase();
    let visibleCount = 0;

    destinationCards.forEach((card) => {
      const title = card.getAttribute('data-title')?.toLowerCase() || '';
      const location = card.getAttribute('data-location')?.toLowerCase() || '';
      const cardCategory = card.getAttribute('data-category')?.toLowerCase() || '';
      const tags = card.getAttribute('data-tags')?.toLowerCase() || '';

      const matchesKeyword =
        !cleanKeyword ||
        title.includes(cleanKeyword) ||
        location.includes(cleanKeyword) ||
        tags.includes(cleanKeyword);

      const matchesCategory =
        !cleanCategory ||
        cleanCategory === 'semua' ||
        cardCategory === cleanCategory ||
        cardCategory.includes(cleanCategory);

      if (matchesKeyword && matchesCategory) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noDestinationsNotice) {
      if (visibleCount === 0) {
        noDestinationsNotice.classList.remove('d-none');
      } else {
        noDestinationsNotice.classList.add('d-none');
      }
    }
  };

  // Search form submit
  if (heroSearchForm) {
    heroSearchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const keyword = searchInput ? searchInput.value : '';
      const category = categorySelect ? categorySelect.value : '';

      filterDestinations(keyword, category);

      const destSection = document.getElementById('destinasi');
      if (destSection) {
        destSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  // Live filter on search input
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const keyword = searchInput.value;
      const category = categorySelect ? categorySelect.value : '';
      filterDestinations(keyword, category);
    });
  }

  // Category select change
  if (categorySelect) {
    categorySelect.addEventListener('change', () => {
      const keyword = searchInput ? searchInput.value : '';
      const category = categorySelect.value;
      filterDestinations(keyword, category);
    });
  }

  // Reset filter button
  const resetDestBtn = document.getElementById('resetDestFilterBtn');
  if (resetDestBtn) {
    resetDestBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = '';
      filterDestinations('', '');
    });
  }

  // Quick tag links
  const quickTags = document.querySelectorAll('.hero-quick-tag');
  quickTags.forEach((tag) => {
    tag.addEventListener('click', (e) => {
      e.preventDefault();
      const searchVal = tag.getAttribute('data-search') || tag.innerText.trim();
      if (searchInput) searchInput.value = searchVal;
      if (categorySelect) categorySelect.value = '';
      filterDestinations(searchVal, '');

      const destSection = document.getElementById('destinasi');
      if (destSection) {
        destSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // "Lihat Semua Destinasi" button action
  const viewAllDestBtn = document.getElementById('viewAllDestBtn');
  if (viewAllDestBtn) {
    viewAllDestBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = '';
      filterDestinations('', '');
      
      const destSection = document.getElementById('destinasi');
      if (destSection) {
        destSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  // Category cards click (Triggers filter by category)
  const categoryCards = document.querySelectorAll('.category-card-trigger');
  categoryCards.forEach((card) => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      const categoryId = card.getAttribute('data-category-id') || '';
      if (categorySelect) {
        categorySelect.value = categoryId;
      }
      if (searchInput) {
        searchInput.value = '';
      }
      filterDestinations('', categoryId);

      const destSection = document.getElementById('destinasi');
      if (destSection) {
        destSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // ========================================================================
  // 5. Rekomendasi Tabs (Stay, Culinary, Experiences)
  // ========================================================================
  const recTabs = document.querySelectorAll('.rekomendasi-tab-btn');
  const recCards = document.querySelectorAll('.recommendation-card-col');

  recTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      recTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const targetCategory = tab.getAttribute('data-category');

      recCards.forEach((card) => {
        const cardType = card.getAttribute('data-type');
        if (targetCategory === 'all' || cardType === targetCategory) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // ========================================================================
  // 6. Interactive Travel Planner Modal
  // ========================================================================
  const plannerForm = document.getElementById('plannerBuilderForm');
  if (plannerForm) {
    plannerForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const destination = document.getElementById('planDestSelect').value;
      const days = document.getElementById('planDaysInput').value;
      const travelerType = document.getElementById('planTypeSelect').value;

      // Update mockup text live in the Travel Planner section
      const mockupTitle = document.getElementById('mockupTripTitle');
      const mockupMeta = document.getElementById('mockupTripMeta');

      if (mockupTitle) {
        mockupTitle.textContent = `Rencana Liburan ${days} Hari: Eksplorasi ${destination}`;
      }
      if (mockupMeta) {
        mockupMeta.textContent = `${days} Hari • Kategori: ${travelerType} • Rekomendasi Terpadu`;
      }

      // Close modal
      const modalEl = document.getElementById('plannerModal');
      if (modalEl) {
        const bsModal = bootstrap.Modal.getInstance(modalEl);
        if (bsModal) bsModal.hide();
      }

      // Smooth scroll to Travel Planner section
      const plannerSection = document.getElementById('planner');
      if (plannerSection) {
        plannerSection.scrollIntoView({ behavior: 'smooth' });
      }

      showToast(`Itinerary untuk ${destination} (${days} Hari - ${travelerType}) berhasil diperbarui ke rencana perjalanan Anda!`);
    });
  }

  // ========================================================================
  // 7. Destination Detail Modal
  // ========================================================================
  const detailModal = document.getElementById('destinationDetailModal');
  if (detailModal) {
    detailModal.addEventListener('show.bs.modal', (event) => {
      const button = event.relatedTarget;
      if (!button) return;

      const title = button.getAttribute('data-title');
      const location = button.getAttribute('data-location');
      const category = button.getAttribute('data-category');
      const rating = button.getAttribute('data-rating');
      const image = button.getAttribute('data-image');
      const description = button.getAttribute('data-description');
      const highlights = button.getAttribute('data-highlights');

      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalLocation').textContent = location;
      document.getElementById('modalCategory').textContent = category;
      document.getElementById('modalRating').textContent = rating;
      document.getElementById('modalImage').src = image;
      document.getElementById('modalDescription').textContent = description;

      const highlightsContainer = document.getElementById('modalHighlights');
      highlightsContainer.innerHTML = '';
      if (highlights) {
        const tagList = highlights.split(',');
        tagList.forEach((tag) => {
          const badge = document.createElement('span');
          badge.className = 'badge bg-light text-success border me-1 mb-1 p-2 font-weight-normal';
          badge.textContent = `✓ ${tag.trim()}`;
          highlightsContainer.appendChild(badge);
        });
      }
    });
  }

  // ========================================================================
  // 8. Fitur Pengguna: Favorit Destinasi (LocalStorage & Interactive Toggle)
  // ========================================================================
  const STORAGE_KEY = 'jelajahnusa_favorites';

  // Deteksi lokasi path direktori agar URL antarhalaman selalu valid
  const isInsidePages = window.location.pathname.includes('/pages/');
  const getDetailUrl = (item) => {
    if (String(item.id) === '2' || (item.nama && item.nama.toLowerCase().includes('bali'))) {
      return isInsidePages ? 'detail-destinasi.php' : 'pages/detail-destinasi.php';
    }
    return isInsidePages ? '../index.php#destinasi' : '#destinasi';
  };

  // Mengambil daftar favorit dengan deduplikasi ketat
  const getFavorites = () => {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      const list = data ? JSON.parse(data) : [];
      if (!Array.isArray(list)) return [];

      // Validasi dan eliminasi data duplikat berdasarkan ID unik
      const unique = [];
      const seenIds = new Set();
      for (const item of list) {
        if (!item || !item.id) continue;
        const strId = String(item.id);
        if (!seenIds.has(strId)) {
          seenIds.add(strId);
          unique.push(item);
        }
      }
      return unique;
    } catch (e) {
      console.error('Gagal membaca data favorit:', e);
      return [];
    }
  };

  const saveFavorites = (favs) => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(favs));
    } catch (e) {
      console.error('Gagal menyimpan data favorit:', e);
    }
  };

  const updateFavoriteUI = () => {
    const favorites = getFavorites();
    
    // 1. Perbarui angka badge counter di navbar
    const badge = document.getElementById('navFavCount');
    if (badge) {
      badge.textContent = favorites.length;
    }

    // 2. Perbarui tampilan tombol hati pada kartu & hero section
    const favButtons = document.querySelectorAll('.btn-card-fav');
    favButtons.forEach((btn) => {
      const id = btn.getAttribute('data-id');
      const isFav = favorites.some((item) => String(item.id) === String(id));
      const icon = btn.querySelector('i');
      const textSpan = btn.querySelector('.detail-fav-text');

      if (isFav) {
        btn.classList.add('active');
        if (icon) {
          icon.className = 'bi bi-heart-fill text-danger';
        }
        if (textSpan) {
          textSpan.textContent = 'Tersimpan di Favorit';
        }
      } else {
        btn.classList.remove('active');
        if (icon) {
          icon.className = 'bi bi-heart';
        }
        if (textSpan) {
          textSpan.textContent = 'Simpan Favorit';
        }
      }
    });

    // 3. Perbarui isi Modal Cepat Favorit (#favoritesModal)
    const favModalContainer = document.getElementById('favoritesListContainer');
    const favModalEmpty = document.getElementById('favoritesEmptyState');

    if (favModalContainer && favModalEmpty) {
      favModalContainer.innerHTML = '';
      if (favorites.length === 0) {
        favModalEmpty.classList.remove('d-none');
      } else {
        favModalEmpty.classList.add('d-none');

        favorites.forEach((item) => {
          const detailLink = getDetailUrl(item);
          const itemEl = document.createElement('div');
          itemEl.className = 'favorite-item-card';
          itemEl.innerHTML = `
            <img src="${item.foto}" alt="${item.nama}" class="favorite-item-img">
            <div class="flex-grow-1 overflow-hidden pe-2">
              <a href="${detailLink}" class="fw-bold text-dark text-decoration-none d-block text-truncate mb-0">${item.nama}</a>
              <span class="text-muted small"><i class="bi bi-geo-alt me-1 text-success"></i>${item.lokasi}</span>
            </div>
            <div class="d-flex align-items-center gap-1 flex-shrink-0">
              <a href="${detailLink}" class="btn btn-sm btn-outline-forest rounded-pill px-2 py-1" style="font-size: 0.76rem;" title="Lihat Destinasi">
                Lihat
              </a>
              <button class="btn btn-sm btn-outline-danger border-0 rounded-circle btn-remove-fav" data-id="${item.id}" title="Hapus dari favorit">
                <i class="bi bi-trash3"></i>
              </button>
            </div>
          `;
          favModalContainer.appendChild(itemEl);
        });

        // Event handler hapus dari modal
        const removeBtns = favModalContainer.querySelectorAll('.btn-remove-fav');
        removeBtns.forEach((rmBtn) => {
          rmBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const idToRemove = rmBtn.getAttribute('data-id');
            const updated = getFavorites().filter((f) => String(f.id) !== String(idToRemove));
            saveFavorites(updated);
            updateFavoriteUI();
            showToast('Destinasi dihapus dari daftar favorit.');
          });
        });
      }
    }

    // 4. Perbarui isi Halaman Khusus Daftar Favorit (pages/favorit.php) jika ada
    const pageContainer = document.getElementById('pageFavoritesContainer');
    const pageEmptyState = document.getElementById('pageFavoritesEmptyState');
    const pageCountLabel = document.getElementById('pageFavoritesCount');
    const clearBtn = document.getElementById('clearAllFavoritesBtn');

    if (pageCountLabel) {
      pageCountLabel.textContent = `${favorites.length} Destinasi Disimpan`;
    }

    if (clearBtn) {
      if (favorites.length === 0) {
        clearBtn.classList.add('d-none');
      } else {
        clearBtn.classList.remove('d-none');
      }
    }

    if (pageContainer && pageEmptyState) {
      pageContainer.innerHTML = '';
      if (favorites.length === 0) {
        pageEmptyState.classList.remove('d-none');
      } else {
        pageEmptyState.classList.add('d-none');

        favorites.forEach((item) => {
          const detailLink = getDetailUrl(item);
          const colEl = document.createElement('div');
          colEl.className = 'col-lg-4 col-md-6 mb-4';
          colEl.innerHTML = `
            <div class="destination-card">
              <div class="destination-img-box">
                <img src="${item.foto}" alt="${item.nama}" class="destination-img" loading="lazy">
                <span class="destination-category-badge">Favorit Saya</span>
                <button type="button" class="btn-card-fav active btn-remove-from-grid" data-id="${item.id}" data-nama="${item.nama}" title="Hapus dari favorit">
                  <i class="bi bi-heart-fill text-danger"></i>
                </button>
              </div>
              <div class="destination-content">
                <div class="destination-meta-row">
                  <span class="destination-location">
                    <i class="bi bi-geo-alt"></i> ${item.lokasi}
                  </span>
                </div>
                <h3 class="destination-name">${item.nama}</h3>
                <p class="destination-summary text-muted small">Destinasi pilihan yang telah tersimpan dalam daftar perjalanan impianmu.</p>
                <div class="destination-bottom mt-auto">
                  <a href="${detailLink}" class="btn btn-outline-forest btn-sm rounded-pill px-3">
                    <i class="bi bi-compass me-1"></i> Buka Destinasi
                  </a>
                  <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 border-0 btn-remove-from-grid-text" data-id="${item.id}">
                    <i class="bi bi-trash3 me-1"></i> Hapus
                  </button>
                </div>
              </div>
            </div>
          `;
          pageContainer.appendChild(colEl);
        });

        // Event handler hapus dari grid halaman favorit
        const gridRemoveBtns = pageContainer.querySelectorAll('.btn-remove-from-grid, .btn-remove-from-grid-text');
        gridRemoveBtns.forEach((gBtn) => {
          gBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const idToRemove = gBtn.getAttribute('data-id');
            const itemObj = favorites.find((f) => String(f.id) === String(idToRemove));
            const updated = getFavorites().filter((f) => String(f.id) !== String(idToRemove));
            saveFavorites(updated);
            updateFavoriteUI();
            const itemName = itemObj ? itemObj.nama : 'Destinasi';
            showToast(`${itemName} dihapus dari daftar favorit.`);
          });
        });
      }
    }
  };

  // Event Listener tombol Favorit di kartu atau hero section
  const favButtons = document.querySelectorAll('.btn-card-fav');
  favButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();

      const id = btn.getAttribute('data-id');
      const nama = btn.getAttribute('data-nama');
      const lokasi = btn.getAttribute('data-lokasi');
      const foto = btn.getAttribute('data-foto');

      if (!id || !nama) return;

      let favorites = getFavorites();
      const existingIndex = favorites.findIndex((f) => String(f.id) === String(id));

      if (existingIndex > -1) {
        // Hapus jika sudah ada
        favorites.splice(existingIndex, 1);
        saveFavorites(favorites);
        updateFavoriteUI();
        showToast(`${nama} dihapus dari destinasi favorit.`);
      } else {
        // Tambahkan ke daftar dengan jaminan data unik
        favorites.push({ 
          id: String(id), 
          nama: String(nama), 
          lokasi: String(lokasi || ''), 
          foto: String(foto || '')
        });
        saveFavorites(favorites);
        updateFavoriteUI();
        showToast(`❤️ ${nama} ditambahkan ke destinasi favoritmu!`);
      }
    });
  });

  // Tombol Hapus Semua Favorit (di halaman pages/favorit.php)
  const clearAllBtn = document.getElementById('clearAllFavoritesBtn');
  if (clearAllBtn) {
    clearAllBtn.addEventListener('click', () => {
      if (getFavorites().length === 0) return;
      if (confirm('Apakah Anda yakin ingin menghapus seluruh destinasi dari daftar favorit?')) {
        saveFavorites([]);
        updateFavoriteUI();
        showToast('Seluruh daftar favorit telah dikosongkan.');
      }
    });
  }

  // Sinkronisasi instan antar tab / jendela browser
  window.addEventListener('storage', (e) => {
    if (e.key === STORAGE_KEY) {
      updateFavoriteUI();
    }
  });

  // Jalankan inisialisasi awal UI favorit saat halaman selesai dimuat
  updateFavoriteUI();

  // ========================================================================
  // 9. Toast Notification Helper
  // ========================================================================
  function showToast(message) {
    let container = document.querySelector('.nature-toast-box');
    if (!container) {
      container = document.createElement('div');
      container.className = 'nature-toast-box';
      document.body.appendChild(container);
    }

    const toast = document.createElement('div');
    toast.className = 'nature-toast';
    toast.innerHTML = `<i class="bi bi-info-circle-fill text-success"></i><span>${message}</span>`;
    container.appendChild(toast);

    setTimeout(() => {
      toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(10px)';
      setTimeout(() => toast.remove(), 400);
    }, 3200);
  }

  // ========================================================================
  // 10. Auth Modal (Login / Register Switching)
  // ========================================================================
  const tabLogin = document.getElementById('tabLoginBtn');
  const tabRegister = document.getElementById('tabRegisterBtn');
  const formLogin = document.getElementById('loginForm');
  const formRegister = document.getElementById('registerForm');
  const authModalTitle = document.getElementById('authModalTitle');

  const navLoginBtn = document.getElementById('navLoginBtn');
  const navRegisterBtn = document.getElementById('navRegisterBtn');

  // Helper alert autentikasi modal
  const showAuthAlert = (message, isSuccess = false) => {
    const alertEl = document.getElementById('authAlert');
    if (alertEl) {
      alertEl.textContent = message;
      alertEl.className = isSuccess
        ? 'alert alert-success py-2 px-3 small rounded-3 mb-3'
        : 'alert alert-danger py-2 px-3 small rounded-3 mb-3';
      alertEl.classList.remove('d-none');
    } else {
      showToast(message);
    }
  };

  const clearAuthAlert = () => {
    const alertEl = document.getElementById('authAlert');
    if (alertEl) {
      alertEl.textContent = '';
      alertEl.classList.add('d-none');
    }
  };

  const authModalEl = document.getElementById('authModal');
  if (authModalEl) {
    authModalEl.addEventListener('show.bs.modal', () => {
      clearAuthAlert();
    });
  }

  if (tabLogin && tabRegister) {
    tabLogin.addEventListener('click', () => {
      clearAuthAlert();
      tabLogin.className = 'btn btn-forest flex-fill rounded-pill py-1 small fw-bold';
      tabRegister.className = 'btn btn-link text-muted text-decoration-none flex-fill rounded-pill py-1 small fw-bold';
      formLogin.classList.remove('d-none');
      formRegister.classList.add('d-none');
      if (authModalTitle) authModalTitle.textContent = 'Masuk ke JelajahNusa';
    });

    tabRegister.addEventListener('click', () => {
      clearAuthAlert();
      tabRegister.className = 'btn btn-forest flex-fill rounded-pill py-1 small fw-bold';
      tabLogin.className = 'btn btn-link text-muted text-decoration-none flex-fill rounded-pill py-1 small fw-bold';
      formRegister.classList.remove('d-none');
      formLogin.classList.add('d-none');
      if (authModalTitle) authModalTitle.textContent = 'Daftar Akun JelajahNusa';
    });
  }

  // Trigger correct tab from navbar buttons
  if (navLoginBtn && tabLogin) {
    navLoginBtn.addEventListener('click', () => {
      clearAuthAlert();
      tabLogin.click();
    });
  }

  if (navRegisterBtn && tabRegister) {
    navRegisterBtn.addEventListener('click', () => {
      clearAuthAlert();
      tabRegister.click();
    });
  }

  const switchRegisterLink = document.getElementById('switchToRegister');
  if (switchRegisterLink && tabRegister) {
    switchRegisterLink.addEventListener('click', (e) => {
      e.preventDefault();
      clearAuthAlert();
      tabRegister.click();
    });
  }

  const switchLoginLink = document.getElementById('switchToLogin');
  if (switchLoginLink && tabLogin) {
    switchLoginLink.addEventListener('click', (e) => {
      e.preventDefault();
      clearAuthAlert();
      tabLogin.click();
    });
  }

  // Integrasi Autentikasi AJAX: Login
  if (formLogin) {
    formLogin.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAuthAlert();

      const submitBtn = formLogin.querySelector('button[type="submit"]');
      const originalBtnText = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Memproses...';
      }

      const isSubpage = window.location.pathname.includes('/pages/');
      const actionUrl = formLogin.getAttribute('action') || (isSubpage ? '../auth/login.php' : 'auth/login.php');
      const formData = new FormData(formLogin);

      try {
        const response = await fetch(actionUrl, {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        const data = await response.json().catch(() => null);

        if (response.ok && data && data.success) {
          showAuthAlert(data.message || 'Masuk berhasil! Memperbarui sesi...', true);
          showToast(data.message || 'Masuk berhasil!');
          formLogin.reset();
          setTimeout(() => {
            const modalEl = document.getElementById('authModal');
            if (modalEl) {
              const bsModal = bootstrap.Modal.getInstance(modalEl);
              if (bsModal) bsModal.hide();
            }
            window.location.reload();
          }, 800);
        } else {
          const errorMsg = (data && data.message) ? data.message : 'Gagal masuk. Periksa kembali email dan kata sandi Anda.';
          showAuthAlert(errorMsg, false);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
          }
        }
      } catch (err) {
        showAuthAlert('Terjadi gangguan jaringan atau server. Silakan coba lagi.', false);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnText;
        }
      }
    });
  }

  // Integrasi Autentikasi AJAX: Register
  if (formRegister) {
    formRegister.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAuthAlert();

      const submitBtn = formRegister.querySelector('button[type="submit"]');
      const originalBtnText = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Mendaftarkan...';
      }

      const isSubpage = window.location.pathname.includes('/pages/');
      const actionUrl = formRegister.getAttribute('action') || (isSubpage ? '../auth/register.php' : 'auth/register.php');
      const formData = new FormData(formRegister);

      try {
        const response = await fetch(actionUrl, {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        const data = await response.json().catch(() => null);

        if (response.ok && data && data.success) {
          showAuthAlert(data.message || 'Pendaftaran berhasil! Mengalihkan...', true);
          showToast(data.message || 'Pendaftaran berhasil!');
          formRegister.reset();
          setTimeout(() => {
            const modalEl = document.getElementById('authModal');
            if (modalEl) {
              const bsModal = bootstrap.Modal.getInstance(modalEl);
              if (bsModal) bsModal.hide();
            }
            window.location.reload();
          }, 800);
        } else {
          const errorMsg = (data && data.message) ? data.message : 'Pendaftaran gagal. Silakan periksa kembali formulir Anda.';
          showAuthAlert(errorMsg, false);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
          }
        }
      } catch (err) {
        showAuthAlert('Terjadi gangguan jaringan atau server. Silakan coba lagi.', false);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnText;
        }
      }
    });
  }

  // Dummy form handling for feedback (misalnya newsletter)
  const handleDummyForm = (formId, msg) => {
    const form = document.getElementById(formId);
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        showToast(msg);
        const modalEl = document.getElementById('authModal');
        if (modalEl) {
          const bsModal = bootstrap.Modal.getInstance(modalEl);
          if (bsModal) bsModal.hide();
        }
      });
    }
  };

  handleDummyForm('newsletterForm', 'Terima kasih telah berlangganan info wisata JelajahNusa!');

  // Membuka modal Buat Rencana Perjalanan
const btnCreateTrip = document.getElementById('btnCreateTrip');
const createTripModal = document.getElementById('createTripModal');

if (btnCreateTrip && createTripModal) {
  btnCreateTrip.addEventListener('click', () => {
    bootstrap.Modal.getOrCreateInstance(createTripModal).show();
  });
}

// ==========================================
// 11. FITUR SIMPAN RENCANA PERJALANAN
// ==========================================

const TRIP_STORAGE_KEY = 'jelajahnusa_trips';

const createTripForm = document.getElementById('createTripForm');
const tripSelect = document.getElementById('plannerTripSelect');
const tripSummary = document.getElementById('tripSummaryContainer');
const emptyState = document.getElementById('plannerEmptyState');

let trips = JSON.parse(localStorage.getItem(TRIP_STORAGE_KEY) || '[]');

let activeTripId = trips.length > 0 ? trips[0].id : null;

// Menyimpan data ke localStorage
function saveTrips() {
    localStorage.setItem(TRIP_STORAGE_KEY, JSON.stringify(trips));
}

// Menampilkan daftar perjalanan
function renderTrips() {
    if (!tripSelect) return;

    tripSelect.innerHTML = '';

    trips.forEach((trip) => {
        const option = document.createElement('option');
        option.value = trip.id;
        option.textContent = trip.name;
        tripSelect.appendChild(option);
    });

    tripSelect.value = activeTripId || '';

    if (trips.length === 0) {
        if (emptyState) emptyState.classList.remove('d-none');
        if (tripSummary) tripSummary.innerHTML = '';
        return;
    }

    if (emptyState) emptyState.classList.add('d-none');

    const activeTrip = trips.find(
        (trip) => String(trip.id) === String(activeTripId)
    );

    if (!activeTrip) return;

    const formatDate = (date) => {
        return new Date(date + 'T00:00:00').toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
        });
    };

    tripSummary.innerHTML = `
        <div class="trip-summary-card mb-4">
            <h3>${activeTrip.name.replace(/</g, '&lt;')}</h3>
            <p><i class="bi bi-geo-alt"></i> ${activeTrip.destination}</p>
            <p><i class="bi bi-calendar"></i>
                ${formatDate(activeTrip.startDate)}
                - ${formatDate(activeTrip.endDate)}
            </p>
            <p><i class="bi bi-people"></i> ${activeTrip.category}</p>
            <p>${activeTrip.days} Hari Perjalanan</p>
        </div>
    `;
}

// Ketika formulir disimpan
if (createTripForm) {
    createTripForm.addEventListener('submit', (e) => {
        e.preventDefault();

        const name = document.getElementById('tripNameInput').value.trim();
        const destination = document.getElementById('tripDestSelect').value;
        const startDate = document.getElementById('tripStartDateInput').value;
        const endDate = document.getElementById('tripEndDateInput').value;
        const category = document.getElementById('tripCategorySelect').value;
        const notes = document.getElementById('tripNotesInput').value.trim();

        
// Validasi data wajib
if (!name || !destination || !startDate || !endDate || !category) {
    alert('Mohon lengkapi semua data rencana perjalanan!');
    return;
}

// Validasi format tanggal
const tanggalBerangkat = new Date(startDate + 'T00:00:00');
const tanggalPulang = new Date(endDate + 'T00:00:00');

if (
    Number.isNaN(tanggalBerangkat.getTime()) ||
    Number.isNaN(tanggalPulang.getTime())
) {
    alert('Format tanggal tidak valid!');
    return;
}

// Validasi urutan tanggal
if (tanggalPulang < tanggalBerangkat) {
    alert('Tanggal pulang tidak boleh sebelum tanggal berangkat!');
    return;
}

// Validasi panjang nama
if (name.length > 100) {
    alert('Nama perjalanan maksimal 100 karakter!');
    return;
}


        const days = Math.round(
            (new Date(endDate) - new Date(startDate)) / 86400000
        ) + 1;

        const newTrip = {
            id: Date.now(),
            name,
            destination,
            startDate,
            endDate,
            category,
            notes,
            days,
            items: []
        };

        trips.push(newTrip);
        activeTripId = newTrip.id;

        saveTrips();
        renderTrips();

        const modalElement = document.getElementById('createTripModal');
        bootstrap.Modal.getOrCreateInstance(modalElement).hide();

        createTripForm.reset();

        alert('Rencana perjalanan berhasil disimpan!');
    });
}

// Mengganti perjalanan aktif
if (tripSelect) {
    tripSelect.addEventListener('change', () => {
        activeTripId = tripSelect.value;
        renderTrips();
    });
}

// Tampilkan data ketika halaman pertama kali dibuka
renderTrips();


// ==========================================
// FITUR JADWAL HARIAN / ITINERARY
// ==========================================

const itemForm = document.getElementById('addTripItemForm');
const itemDaySelect = document.getElementById('itemDaySelect');
const dayFilterTabs = document.getElementById('dayFilterTabs');
const dayItineraryContainer = document.getElementById('dayItineraryContainer');

let selectedDay = 'all';

// Mengambil perjalanan yang sedang aktif
function getActiveTrip() {
    return trips.find(
        trip => String(trip.id) === String(activeTripId)
    );
}

// Membuat pilihan hari berdasarkan durasi perjalanan
function renderDayOptions() {
    const trip = getActiveTrip();
    if (!trip || !itemDaySelect) return;

    itemDaySelect.innerHTML = '';

    for (let day = 1; day <= trip.days; day++) {
        const option = document.createElement('option');
        option.value = day;
        option.textContent = `Hari ${day}`;
        itemDaySelect.appendChild(option);
    }
}

// Menampilkan tombol filter hari
function renderDayTabs() {
    const trip = getActiveTrip();
    if (!trip || !dayFilterTabs) return;

    dayFilterTabs.innerHTML = `
        <button type="button" class="btn btn-forest btn-sm rounded-pill me-2 mb-2"
            data-day="all">Semua Hari</button>
        ${Array.from({ length: trip.days }, (_, index) => `
            <button type="button"
                class="btn btn-outline-forest btn-sm rounded-pill me-2 mb-2"
                data-day="${index + 1}">
                Hari ${index + 1}
            </button>
        `).join('')}
    `;

    dayFilterTabs.querySelectorAll('[data-day]').forEach(button => {
        button.addEventListener('click', () => {
            selectedDay = button.dataset.day;
            renderDayTabs();
            renderItinerary();
        });
    });

    dayFilterTabs.querySelectorAll('[data-day]').forEach(button => {
        const active = button.dataset.day === String(selectedDay);

        button.classList.toggle('btn-forest', active);
        button.classList.toggle('btn-outline-forest', !active);
    });
}

// Mengamankan teks sebelum ditampilkan ke HTML
function safeText(value) {
    const element = document.createElement('div');
    element.textContent = value || '';
    return element.innerHTML;
}

// Menampilkan aktivitas perjalanan
function renderItinerary() {
    const trip = getActiveTrip();
    if (!trip || !dayItineraryContainer) return;

    trip.items = trip.items || [];

    const days = selectedDay === 'all'
        ? Array.from({ length: trip.days }, (_, index) => index + 1)
        : [Number(selectedDay)];

    dayItineraryContainer.innerHTML = days.map(day => {
        const dayItems = trip.items.filter(
            item => Number(item.day) === day
        );

        return `
            <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Hari ${day}</h5>
                    <span class="badge bg-success-subtle text-success">
                        ${dayItems.length} Aktivitas
                    </span>
                </div>

                ${dayItems.length === 0
                    ? '<p class="text-muted mb-0">Belum ada aktivitas pada hari ini.</p>'
                    : dayItems.map(item => `
                        <div class="border rounded-3 p-3 mb-2">
                            <div class="d-flex justify-content-between gap-2">
                                <div>
                                    <span class="badge bg-light text-success mb-2">
                                        ${safeText(item.category)}
                                    </span>
                                    <h6 class="fw-bold mb-1">
                                        ${safeText(item.name)}
                                    </h6>
                                    <p class="text-muted small mb-1">
                                        <i class="bi bi-geo-alt"></i>
                                        ${safeText(item.location)}
                                    </p>
                                    <p class="text-muted small mb-1">
                                        <i class="bi bi-clock"></i>
                                        ${safeText(item.time)}
                                    </p>
                                    <p class="small mb-0">
                                        ${safeText(item.note)}
                                    </p>
                                </div>

                                <button type="button"
                                    class="btn btn-outline-danger btn-sm align-self-start"
                                    data-delete-item="${item.id}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    `).join('')
                }
            </div>
        `;
    }).join('');
}


// Menyimpan aktivitas baru
if (itemForm) {
    itemForm.addEventListener('submit', event => {
        event.preventDefault();

        const trip = getActiveTrip();

        if (!trip) {
            alert('Buat atau pilih rencana perjalanan terlebih dahulu.');
            return;
        }

        const newItem = {
            id: Date.now(),
            day: Number(itemDaySelect.value),
            category: document.getElementById('itemCategorySelect').value,
            name: document.getElementById('itemNameInput').value.trim(),
            location: document.getElementById('itemLocationInput').value.trim(),
            time: document.getElementById('itemTimeInput').value.trim(),
            photo: document.getElementById('itemPhotoInput').value.trim(),
            note: document.getElementById('itemNoteInput').value.trim()
        };

        // Validasi aktivitas
        if (!newItem.name || !newItem.category || !newItem.day) {
            alert('Nama aktivitas, kategori, dan hari wajib diisi!');
            return;
        }

        if (newItem.name.length > 100) {
            alert('Nama aktivitas maksimal 100 karakter!');
            return;
        }

        trip.items.push(newItem);

        saveTrips();
        renderItinerary();
        renderDayTabs();

        itemForm.reset();
        renderDayOptions();

        const modal = document.getElementById('addTripItemModal');
        bootstrap.Modal.getOrCreateInstance(modal).hide();

        alert('Aktivitas berhasil ditambahkan!');
    });
}

// Menghapus aktivitas
if (dayItineraryContainer) {
    dayItineraryContainer.addEventListener('click', event => {
        const button = event.target.closest('[data-delete-item]');
        if (!button) return;

        const trip = getActiveTrip();
        if (!trip) return;

        if (!confirm('Yakin ingin menghapus aktivitas ini?')) return;

        trip.items = trip.items.filter(
            item => String(item.id) !== button.dataset.deleteItem
        );

        saveTrips();
        renderItinerary();
        renderDayTabs();
    });
}

// Saat memilih perjalanan lain
if (tripSelect) {
    tripSelect.addEventListener('change', () => {
        selectedDay = 'all';
        renderDayOptions();
        renderDayTabs();
        renderItinerary();
    });
}

// Saat membuka modal tambah aktivitas
const addItemButton = document.getElementById('btnOpenAddItemModal');

if (addItemButton) {
    addItemButton.addEventListener('click', () => {
        renderDayOptions();
    });
}

// Tampilkan itinerary saat halaman dibuka
renderDayOptions();
renderDayTabs();
renderItinerary();

// Perbarui tampilan setelah perjalanan baru disimpan
if (createTripForm) {
    createTripForm.addEventListener('submit', () => {
        selectedDay = 'all';

        setTimeout(() => {
            renderDayOptions();
            renderDayTabs();
            renderItinerary();
        }, 0);
    });
}


// ==========================================
// FITUR HAPUS RENCANA PERJALANAN
// ==========================================

const btnDeleteTrip = document.getElementById('btnDeleteCurrentTrip');

if (btnDeleteTrip) {
    btnDeleteTrip.addEventListener('click', () => {
        const trip = getActiveTrip();

        if (!trip) {
            alert('Belum ada rencana perjalanan yang dipilih.');
            return;
        }

        const yakin = confirm(
            `Yakin ingin menghapus rencana "${trip.name}" beserta seluruh aktivitasnya?`
        );

        if (!yakin) return;

        // Hapus perjalanan yang sedang aktif
        trips = trips.filter(
            item => String(item.id) !== String(activeTripId)
        );

        // Pilih perjalanan lain jika masih tersedia
        activeTripId = trips.length > 0 ? trips[0].id : null;
        selectedDay = 'all';

        // Simpan perubahan
        saveTrips();

        // Perbarui tampilan
        renderTrips();

        if (trips.length > 0) {
            renderDayOptions();
            renderDayTabs();
            renderItinerary();
        } else {
            if (dayFilterTabs) dayFilterTabs.innerHTML = '';
            if (dayItineraryContainer) dayItineraryContainer.innerHTML = '';
        }

        alert('Rencana perjalanan berhasil dihapus!');
    });
}


 // ==========================================
 // FITUR CETAK / SIMPAN PDF ITINERARY
 // ==========================================

const btnPrintTrip = document.getElementById('btnPrintTripBtn');

if (btnPrintTrip) {
    btnPrintTrip.addEventListener('click', () => {
        const trip = getActiveTrip();

        if (!trip) {
            alert('Buat atau pilih rencana perjalanan terlebih dahulu!');
            return;
        }

        // Membuat jendela cetak
        const printWindow = window.open('', '_blank');

        if (!printWindow) {
            alert('Izinkan pop-up pada browser untuk mencetak itinerary.');
            return;
        }

        const escapeHTML = (text) => {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        };

        let itineraryHTML = '';

        for (let day = 1; day <= trip.days; day++) {
            const items = trip.items.filter(item => Number(item.day) === day);

            itineraryHTML += `
                <section class="day-section">
                    <h2>Hari ${day}</h2>
                    ${
                        items.length
                        ? items.map(item => `
                            <div class="activity">
                                <strong>${escapeHTML(item.name)}</strong>
                                <p>Kategori: ${escapeHTML(item.category)}</p>
                                <p>Lokasi: ${escapeHTML(item.location)}</p>
                                <p>Waktu: ${escapeHTML(item.time)}</p>
                                <p>Catatan: ${escapeHTML(item.note)}</p>
                            </div>
                        `).join('')
                        : '<p>Belum ada aktivitas untuk hari ini.</p>'
                    }
                </section>
            `;
        }

        printWindow.document.write(`
            <!DOCTYPE html>
            <html lang="id">
            <head>
                <meta charset="UTF-8">
                <title>Itinerary - ${escapeHTML(trip.name)}</title>
                <style>
                    body {
                        font-family: Arial, sans-serif;
                        padding: 30px;
                        color: #29352D;
                    }
                    h1 { color: #345B49; }
                    h2 {
                        border-bottom: 2px solid #A8B99A;
                        padding-bottom: 8px;
                    }
                    .activity {
                        padding: 12px;
                        margin-bottom: 12px;
                        border: 1px solid #ddd;
                        border-radius: 8px;
                    }
                    .activity p { margin: 6px 0; }
                    @media print {
                        body { padding: 0; }
                    }
                </style>
            </head>
            <body>
                <h1>JelajahNusa</h1>
                <h2>${escapeHTML(trip.name)}</h2>
                <p>Destinasi: ${escapeHTML(trip.destination)}</p>
                <p>Tanggal: ${escapeHTML(trip.startDate)} - ${escapeHTML(trip.endDate)}</p>
                <p>Durasi: ${trip.days} Hari</p>
                ${itineraryHTML}
                <script>
                    window.onload = function() {
                        window.print();
                    };
                <\/script>
            </body>
            </html>
        `);

        printWindow.document.close();
    });
}

});
